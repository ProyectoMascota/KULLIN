# =====================================================================
# .env.example — Variables de entorno requeridas para Kulliñ
# Copiar este archivo a .env.local y rellenar valores reales.
# En Vercel: pegar cada variable en Settings → Environment Variables.
# =====================================================================

# --- Supabase ---
# Obtener en: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role: SOLO para uso server-side (cron job de recordatorios)
# NUNCA exponer en cliente
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Resend (email transaccional) ---
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Verificar dominio en https://resend.com/domains antes de enviar a producción
# Sin dominio verificado se puede enviar SOLO a la cuenta del owner

# --- Cron secret (Vercel) ---
# Token aleatorio para autorizar /api/cron/recordatorios
# Generar con: openssl rand -base64 32
CRON_SECRET=cambia-esto-por-un-string-largo-y-aleatorio

# --- App ---
NEXT_PUBLIC_APP_URL=https://kullin.vercel.app

# =====================================================================
# CONFIGURACIÓN DEL CRON EN VERCEL
# =====================================================================
# 1. El archivo vercel.json ya define el cron diario a las 13:00 UTC
#    (= 10:00 Chile en horario estándar, 09:00 en horario de verano).
# 2. Vercel automáticamente añade el header Authorization: Bearer ${CRON_SECRET}
#    cuando dispara la función — sin configuración adicional en Vercel UI.
# 3. Tier gratuito: 1 cron job activo (suficiente para este caso).
# 4. Logs disponibles en Vercel Dashboard → Functions → Cron.

# =====================================================================
# DEPENDENCIAS NPM REQUERIDAS
# =====================================================================
# npm install @supabase/ssr @supabase/supabase-js resend zod
